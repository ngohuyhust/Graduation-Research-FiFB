# Copy to .env in this directory. Docker Compose reads it directly.
# Supabase: use the Session pooler host/username from Connect, port 5432.
# JDBC URL has no username or password. Password below is the literal password.
FLYWAY_URL=jdbc:postgresql://HOST:5432/postgres?sslmode=require
FLYWAY_USER=postgres.PROJECT_REF
FLYWAY_PASSWORD='YOUR_DATABASE_PASSWORD'
